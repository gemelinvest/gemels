---
import { Picture } from "astro:assets";
import { about } from "../data/site";
---

<section class="section" id={about.id} aria-labelledby="about-title">
  <div class="wrap split">
    <figure class="split__media">
      <Picture
        src={about.image}
        alt={about.imageAlt}
        formats={["avif", "webp"]}
        widths={[480, 768, 1100]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        loading="lazy"
      />
    </figure>
    <div>
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 id="about-title">{about.title}</h2>
      {about.paragraphs.map((paragraph) => <p class="lede">{paragraph}</p>)}
      <p><span class="placeholder-flag">ניסוח זמני</span></p>
      <a class="btn btn--primary" href={about.cta.href}>{about.cta.label}</a>
    </div>
  </div>
</section>
