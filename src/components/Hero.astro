---
import { Picture } from "astro:assets";
import { hero, phone } from "../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={hero.image}
      alt={hero.imageAlt}
      formats={["avif", "webp"]}
      widths={[768, 1200, 1664]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="wrap hero__copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">{hero.title}</h1>
    <p class="lede">{hero.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
    <p class="hero__phone">
      או התקשרו לשירות לקוחות:
      <a href={phone.href}>{phone.display}</a>
    </p>
  </div>
</section>
