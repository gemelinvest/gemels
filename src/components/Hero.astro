---
import { Picture } from "astro:assets";
import { hero } from "../data/site";

const goldWord = "טובות";
const goldAt = hero.title.lastIndexOf(goldWord);
const titleLead = goldAt === -1 ? hero.title : hero.title.slice(0, goldAt);
const titleGold = goldAt === -1 ? "" : goldWord;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={hero.image}
      alt={hero.imageAlt}
      formats={["avif", "webp"]}
      widths={[768, 1200, 1664]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__copy">
    <h1 id="hero-title">{titleLead}{titleGold ? <span class="hero__gold">{titleGold}</span> : null}</h1>
    <p class="lede">{hero.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
</section>
