---
import { brand, email, legalNav, nav, office, phone, withBase } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-logo" href={withBase("/")} aria-label={`${brand.name}, דף הבית`}>
        <img src={withBase("/brand/logo.png")} width="1698" height="926" alt="" />
      </a>
      <p class="footer-note">שירות לקוחות: <a class="phone-num" dir="ltr" href={phone.href}>{phone.display}</a></p>
      <p class="footer-note">{office.street}, {office.city}</p>
      <p class="footer-note">
        <a href={email.href}>{email.display}</a>
        {email.temporary ? " (כתובת זמנית)" : ""}
      </p>
    </div>
    <nav aria-label="ניווט בתחתית">
      <h2>ניווט</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="מידע">
      <h2>מידע</h2>
      <ul>
        {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap footer-base">
    <p class="footer-rights"><span>זכויות שמורות</span><span class="footer-rights__mark">©</span><span dir="ltr">ONYX Technology Systems</span></p>
  </div>
</footer>
