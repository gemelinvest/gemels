---
import { brand, email, legalNav, nav, office, phone, withBase } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-logo" href={withBase("/")} aria-label={`${brand.name}, דף הבית`}>
        <img src={withBase("/brand/logo.png")} width="554" height="302" alt="" />
      </a>
      <p class="footer-note">שירות לקוחות: <a href={phone.href}>{phone.display}</a></p>
      <p class="footer-note">{office.street}, {office.city}</p>
      <p class="footer-note">
        <a href={email.href}>{email.display}</a>
        {email.temporary ? " (כתובת זמנית)" : ""}
      </p>
    </div>
    <nav aria-label="ניווט בתחתית">
      <h2>ניווט</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="מידע">
      <h2>מידע</h2>
      <ul>
        {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <section aria-labelledby="regulatory-heading">
      <h2 id="regulatory-heading">מידע רגולטורי</h2>
      <div class="regulatory">
        <p><strong>{office.name}</strong></p>
        <p>ח.פ. {office.hp}</p>
        <p>{office.street}, {office.city}</p>
        <p>מספר רישיון לא נמסר עדיין, ולכן הוא לא מופיע כאן.</p>
      </div>
    </section>
  </div>
  <div class="wrap footer-base">
    <p>© {year} {brand.name}</p>
  </div>
</footer>
