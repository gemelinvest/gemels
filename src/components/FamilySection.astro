---
import { Picture } from "astro:assets";
import { family, phone } from "../data/site";
---

<section class="section" aria-labelledby="family-title">
  <div class="wrap family">
    <figure class="family__photo">
      <Picture
        src={family.image}
        alt={family.imageAlt}
        formats={["avif", "webp"]}
        widths={[640, 960, 1400]}
        sizes="(min-width: 1024px) 62vw, 100vw"
        loading="lazy"
      />
    </figure>
    <div class="family__panel">
      <p class="eyebrow">{family.eyebrow}</p>
      <h2 id="family-title">{family.title}</h2>
      <p>{family.text}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href={family.cta.href}>{family.cta.label}</a>
        <a class="btn btn--line" href={phone.href}>התקשרו עכשיו {phone.display}</a>
      </div>
    </div>
  </div>
</section>
