---
import { brand, menuGroups, nav, phone, withBase } from "../data/site";

const path = Astro.url.pathname;
const home = withBase("/");
const plainLinks = nav.filter((item) => item.label !== "שירותים");

function isCurrent(href: string) {
  if (href === home) return path === "/" || path === home || `${path}/` === home;
  if (href.includes("#")) return false;
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={home} aria-label={`${brand.name}, דף הבית`}>
      <img src={withBase("/brand/logo.png")} width="1699" height="926" alt="" />
    </a>

    <details class="nav-details" open>
      <summary class="nav-toggle">תפריט</summary>
      <script is:inline>
        if (window.matchMedia("(max-width: 1023px)").matches) {
          document.currentScript.parentElement.removeAttribute("open");
        }
      </script>
      <nav class="nav-panel" aria-label="ניווט ראשי">
        <a href={home} aria-current={isCurrent(home) ? "page" : undefined}>דף הבית</a>
        {
          menuGroups
            .filter((group) => group.label !== "ביטוח עסקים")
            .map((group) => (
            <details class="menu-drop">
              <summary class="menu-summary">{group.label}</summary>
              <div class="mega">
                <p class="mega__note">הסבר קצר. זה אינו ייעוץ אישי ואינו הצעת מחיר.</p>
                {group.items.map((item) => (
                  <a class="mega__link" href={item.href}>
                    <span class="mega__title">{item.title}</span>
                    <span class="mega__text">{item.text}</span>
                  </a>
                ))}
              </div>
            </details>
          ))
        }
        {
          plainLinks
            .filter((item) => item.href !== home && item.label !== "צור קשר")
            .map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
        }
      </nav>
    </details>

    <div class="header-actions">
      <a class="btn btn--primary header-call" href={phone.href} aria-label={`חייגו ${phone.display}`}>
        <span class="header-call__num phone-num" dir="ltr">{phone.display}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const navDetails = document.querySelector(".nav-details");
  const desktopNav = window.matchMedia("(min-width: 1024px)");
  const syncNav = () => {
    if (!(navDetails instanceof HTMLDetailsElement)) return;
    if (desktopNav.matches) navDetails.open = true;
    else navDetails.open = false;
  };
  desktopNav.addEventListener("change", syncNav);

  const panel = document.querySelector(".nav-panel");
  panel?.addEventListener(
    "toggle",
    (event) => {
      const current = event.target;
      if (!(current instanceof HTMLDetailsElement) || !current.open || !current.classList.contains("menu-drop")) return;
      panel.querySelectorAll(".menu-drop[open]").forEach((node) => {
        if (node !== current) node.removeAttribute("open");
      });
    },
    true,
  );
</script>
