---
import { brand, menuGroups, nav, phone, withBase } from "../data/site";

const path = Astro.url.pathname;
const home = withBase("/");
const plainLinks = nav.filter((item) => item.label !== "שירותים");

function isCurrent(href: string) {
  if (href === home) return path === "/" || path === home || `${path}/` === home;
  if (href.includes("#")) return false;
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={home} aria-label={`${brand.name}, דף הבית`}>
      <img src={withBase("/brand/logo.png")} width="554" height="302" alt="" />
    </a>

    <details class="nav-details">
      <summary class="nav-toggle">תפריט</summary>
      <nav class="nav-panel" aria-label="ניווט ראשי">
        <a href={home} aria-current={isCurrent(home) ? "page" : undefined}>דף הבית</a>
        {
          menuGroups.map((group) => (
            <details class="menu-drop">
              <summary class="menu-summary">{group.label}</summary>
              <div class="mega">
                <p class="mega__note">הסבר קצר לכל תחום. הניסוח הסופי יאושר לפני פרסום.</p>
                {group.items.map((item) => (
                  <a class="mega__link" href={item.href}>
                    <span class="mega__title">{item.title}</span>
                    <span class="mega__text">{item.text}</span>
                  </a>
                ))}
              </div>
            </details>
          ))
        }
        {
          plainLinks
            .filter((item) => item.href !== home)
            .map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
        }
      </nav>
    </details>

    <div class="header-actions">
      <a class="phone-link phone-link--text" href={phone.href}>{phone.display}</a>
      <a class="phone-link phone-link--icon" href={phone.href} aria-label={`התקשרות ${phone.display}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M7 3.8h3.2l1.2 3-2 1.2a12.5 12.5 0 0 0 6.6 6.6l1.2-2 3 1.2V17a2 2 0 0 1-2.2 2A15.2 15.2 0 0 1 5 6a2 2 0 0 1 2-2.2Z" />
        </svg>
      </a>
      <a class="btn btn--primary" href={withBase("/#contact")}>צור קשר</a>
    </div>
  </div>
</header>

<script>
  const panel = document.querySelector(".nav-panel");
  panel?.addEventListener(
    "toggle",
    (event) => {
      const current = event.target;
      if (!(current instanceof HTMLDetailsElement) || !current.open || !current.classList.contains("menu-drop")) return;
      panel.querySelectorAll(".menu-drop[open]").forEach((node) => {
        if (node !== current) node.removeAttribute("open");
      });
    },
    true,
  );
</script>
