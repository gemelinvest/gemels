---
import type { ServiceIcon } from "../data/site";

interface Props {
  name: ServiceIcon;
}

const { name } = Astro.props;
---

{
  name === "gemel" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <path d="M12 3.5 5 7v5.2c0 4.2 2.8 6.8 7 8.3 4.2-1.5 7-4.1 7-8.3V7l-7-3.5Z" />
      <path d="M9 12.2h6M12 9.2v6" />
    </svg>
  )
}
{
  name === "pension" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <path d="M4 18.5h16" />
      <path d="M6.5 18.5V10l5.5-4 5.5 4v8.5" />
      <path d="M10 18.5v-4h4v4" />
    </svg>
  )
}
{
  name === "insurance" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <circle cx="12" cy="12" r="7.5" />
      <path d="M12 8.2v4.2l2.6 1.6" />
    </svg>
  )
}
{
  name === "savings" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <path d="M5 16.5c1.6-3 3.4-4.5 7-4.5s5.4 1.5 7 4.5" />
      <path d="M8 10.2a4 4 0 0 1 8 0" />
      <path d="M12 6.2v2" />
    </svg>
  )
}
{
  name === "finance" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <path d="M4.5 16.5 9 11l3 2.5 6.5-7" />
      <path d="M14.5 6.5H19v4.5" />
    </svg>
  )
}
{
  name === "personal" && (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <circle cx="12" cy="8" r="2.6" />
      <path d="M6.5 18.2c.8-2.6 2.7-3.9 5.5-3.9s4.7 1.3 5.5 3.9" />
    </svg>
  )
}
