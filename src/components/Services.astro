---
import { menuGroups, services, withBase } from "../data/site";
import Icons from "./Icons.astro";
---

<section class="section section--white" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">שירותים</p>
      <h2 id="services-title">התחומים שמרכזים בגמלס</h2>
      <p class="lede">
        פנסיה, גמל, פרישה וביטוח. כל כרטיס הוא נקודת פתיחה לשיחה, לא הצעה מוכנה.
      </p>
    </div>
    <div class="service-grid">
      {
        services.map((service) => (
          <a class="card card--link" href={withBase("/#contact")}>
            <span class="icon-badge">
              <Icons name={service.icon} />
            </span>
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
          </a>
        ))
      }
    </div>
    <div class="topic-groups">
      {
        menuGroups.map((group) => (
          <section class="topic-card" aria-labelledby={`group-${group.items[0].id}`}>
            <h3 id={`group-${group.items[0].id}`}>{group.label}</h3>
            <ul class="topic-list">
              {group.items.map((item) => (
                <li id={item.id}>
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
