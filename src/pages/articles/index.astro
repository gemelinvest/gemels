---
import Articles from "../../components/Articles.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../data/site";

const crumbs = [
  { href: withBase("/"), label: "דף הבית" },
  { href: withBase("/articles/"), label: "מאמרים" },
];
---

<BaseLayout
  title="מאמרים ומידע"
  description="מאמרים של גמלס על פנסיה, גמל וביטוח דירה. מידע כללי, לא ייעוץ אישי."
  breadcrumbs={crumbs}
>
  <Articles asPage />
</BaseLayout>
