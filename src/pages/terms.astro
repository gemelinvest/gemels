---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../data/site";

const crumbs = [
  { href: withBase("/"), label: "דף הבית" },
  { href: withBase("/terms/"), label: "תנאי שימוש" },
];
---

<BaseLayout
  title="תנאי שימוש"
  description="עמוד תנאי שימוש של גמל INS. נוסח התנאים עדיין לא סופק."
  breadcrumbs={crumbs}
>
  <article class="wrap prose">
    <p><span class="placeholder-flag">ממתין לנוסח</span></p>
    <p>
      תנאי השימוש עדיין לא נכתבו. אין לראות בטקסטים הזמניים באתר ייעוץ, הצעה, או התחייבות.
    </p>
  </article>
</BaseLayout>
